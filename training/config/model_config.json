{
    "random_seed": 42,
    "precision": "float32",
    "embedding": {
        "input_type": "SNP",
        "input_dims": 10,
        "Block_length": 1000,
        "num_chromosomes": 24,
        "chromosome_embedding_dim": 8,
        "CNN_Kernel": [3, 5, 7, 9, 11, 13, 15, 17],
        "CNN_Dilation": [1, 2, 3, 4, 5, 6, 7, 8],
        "CNN_layers": 1,
        "dropout_rate": 0.1,
        "position_encoding": true,
        "normalization": false,
        "activation": "gelu",
        "aux_ffn_expansion_factor": 4
    },
    "GFI_FormerBLOCKS": {
        "num_blocks": 2,
        "blocks": [
            {
                "name": "SNP_Transformer",
                "context_length": 1000,
                "encoder": {
                    "num_layers": 2,
                    "attention": {
                        "type": "standard",
                        "hidden_dims": 64,
                        "num_heads": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    },
                    "ffn_sharing": false,
                    "ffn_expansion_factor": 2
                },
                "decoder": {
                    "num_layers": 1,
                    "cross_attention": {
                        "type": "standard",
                        "head_dims": 32,
                        "num_heads": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0,
                        "v_projection_source": "encoder"
                    },
                    "MOE": {
                        "enabled": true,
                        "num_experts": 1,
                        "experts_dims": 64,
                        "exports_expansion_factor": 4,
                        "exports_sharing": false,
                        "capacity_factor": 1.0,
                        "dropout_rate": 0.1,
                        "aux_ffn_expansion_factor": 4
                    },
                    "pooling": {
                        "type": "self_attention",
                        "head_dims": 64,
                        "num_heads": 2,
                        "ffn_expansion_factor": 2,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    }
                }
            },
            {
                "name": "Gene_Transformer",
                "context_length": 1000,
                "encoder": {
                    "num_layers": 2,
                    "attention": {
                        "type": "standard",
                        "hidden_dims": 64,
                        "num_heads": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    },
                    "ffn_sharing": false,
                    "ffn_expansion_factor": 2
                },
                "decoder": {
                    "num_layers": 1,
                    "cross_attention": {
                        "type": "standard",
                        "head_dims": 32,
                        "num_heads": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0,
                        "v_projection_source": "encoder"
                    },
                    "MOE": {
                        "enabled": true,
                        "num_experts": 1,
                        "experts_dims": 64,
                        "exports_expansion_factor": 4,
                        "exports_sharing": false,
                        "capacity_factor": 1.0,
                        "dropout_rate": 0.1,
                        "aux_ffn_expansion_factor": 4
                    },
                    "pooling": {
                        "type": "self_attention",
                        "head_dims": 64,
                        "num_heads": 2,
                        "ffn_expansion_factor": 2,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    }
                }
            }
        ]
    },
    "output_layer": {
        "phenotype_dim": 2,
        "phenotype_name": ["BW", "LE"],
        "hidden_expansion_dims": 4,
        "activation": "relu",
        "dropout_rate": 0.1
    },
    "loss_config": {
        "primary_loss": {
            "enabled": true,
            "type": "mse",
            "pearson_factor": 0.2,
            "reduction": "mean"
        },
        "auxiliary_losses": {
            "Deep_Supervision": {
                "enabled": false,
                "type": "pearson",
                "weight": [0.1, 0.15],
                "pearson_factor": 10,
                "reduction": "mean"
            },
            "PWCosSim": {
                "enabled": false,
                "weight": [1, 1],
                "PWCosSim_factor": 10,
                "reduction": "mean",
                "eps": 1e-8,
                "gamma": 1.0
            },
            "l1_regularization": {
                "enabled": false,
                "weight": 1.0e-8
            },
            "correlation": {
                "enabled": false,
                "weight": 0.01
            }
        }
    },
    "phenotype": {
        "distribution": "normal",
        "normalize": true,
        "scaling_method": "standard",
        "target_log_variance": 0
    }
}